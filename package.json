    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "prettier": "^3.9.6",
    "rollup": "^4.62.4",
    "typescript": "^7.0.2"
  }
}
