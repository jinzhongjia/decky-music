{
  "name": "decky-music",
  "version": "1.1.6",
  "description": "SteamOS 游戏模式音乐插件(QQ音乐 + 网易云)",
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "test:ui": "node --test tests/*.test.mjs",
    "test:focus": "node --test tests/pageFocus.test.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "lint": "tsc --noEmit && prettier --check ."
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@1": "^1.1.21",
      "brace-expansion@2": "^2.1.7"
    }
  },
  "remote_binary": [
    {
      "name": "player",
      "url": "https://github.com/jinzhongjia/decky-music/releases/download/v1.1.6/player-linux-x64",
      "sha256hash": "2fcabc23b5e2b83b43b7f38e7b24c74718f808f18b0f0f082496b76113bc525d"
    },
    {
      "name": "provider",
      "url": "https://github.com/jinzhongjia/decky-music/releases/download/v1.1.6/provider-linux-x64",
      "sha256hash": "6efc79c9acc3d78034cacd306b7093cb000489fb027f6111a26205e0b38de06d"
    }
  ],
  "dependencies": {
    "@decky/api": "^1.1.3",
    "@decky/ui": "^4.12.0",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "prettier": "^3.9.6",
    "rollup": "^4.62.4",
    "typescript": "^7.0.2"
  }
}
