{
  "name": "decky-music",
  "version": "1.1.4",
  "description": "SteamOS 游戏模式音乐插件(QQ音乐 + 网易云)",
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "test:ui": "node --test tests/*.test.mjs",
    "test:focus": "node --test tests/pageFocus.test.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "lint": "tsc --noEmit && prettier --check ."
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@1": "^1.1.21",
      "brace-expansion@2": "^2.1.7"
    }
  },
  "remote_binary": [
    {
      "name": "player",
      "url": "https://github.com/jinzhongjia/decky-music/releases/download/v1.1.4/player-linux-x64",
      "sha256hash": "def2a8e8786aa1f4185c1e1315ed3ed82f26f470ccf6059d0caa409a567f1a1a"
    },
    {
      "name": "provider",
      "url": "https://github.com/jinzhongjia/decky-music/releases/download/v1.1.4/provider-linux-x64",
      "sha256hash": "60ead39ad597211d37053d2093a26c1599d5d62d6088766bd1185def47df819b"
    }
  ],
  "dependencies": {
    "@decky/api": "^1.1.3",
    "@decky/ui": "^4.12.0",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "prettier": "^3.9.6",
    "rollup": "^4.62.4",
    "typescript": "^7.0.2"
  }
}
