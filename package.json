{
  "name": "decky-music",
  "version": "1.1.1",
  "description": "SteamOS 游戏模式音乐插件(QQ音乐 + 网易云)",
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "test:ui": "node --test tests/*.test.mjs",
    "test:focus": "node --test tests/pageFocus.test.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "lint": "tsc --noEmit && prettier --check ."
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@1": "^1.1.18",
      "brace-expansion@2": "^2.1.4"
    }
  },
  "remote_binary": [
    {
      "name": "player",
      "url": "https://github.com/jinzhongjia/decky-music/releases/download/v1.1.1/player-linux-x64",
      "sha256hash": "5237e3c4af7ee54db3d05a0c2965e2cf89fab124c949fd7037d2fbc8525e3ff8"
    },
    {
      "name": "provider",
      "url": "https://github.com/jinzhongjia/decky-music/releases/download/v1.1.1/provider-linux-x64",
      "sha256hash": "ddd93bff5aef024837e08efea7fc186947e39f3fa1f1584766b80a45904d00e2"
    }
  ],
  "dependencies": {
    "@decky/api": "^1.1.3",
    "@decky/ui": "^4.12.0",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "prettier": "^3.9.6",
    "rollup": "^4.62.4",
    "typescript": "^7.0.2"
  }
}
