    },
    {
      "name": "provider",
      "url": "https://github.com/jinzhongjia/decky-music/releases/download/v1.1.7/provider-linux-x64",
      "sha256hash": "3ff1b2656d6c224e5d31d0bc2657d93e45cb0171d6fb6cbccceb0255ea9099de"
    }
  ],
  "dependencies": {
