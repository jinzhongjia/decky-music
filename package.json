      "sha256hash": "d851fc963243d0a9d2e02babb7fc78e95799f9ebb59b69c863937c586f48b478"
    },
    {
      "name": "provider",
      "url": "https://github.com/jinzhongjia/decky-music/releases/download/v1.1.3/provider-linux-x64",
      "sha256hash": "8fb14b31af35520f5b29a53b072a1fad4d650607347270f28a47678ab9381fdd"
    }
  ],
  "dependencies": {
    "@decky/api": "^1.1.3",
